{
  "name": "choir-practice-player",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Layered harmony practice player for choir section parts synced from Dropbox.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "sync": "node scripts/sync-dropbox.mjs",
    "align": "node scripts/align-audio.mjs",
    "import-recordings": "node scripts/import-recordings.mjs && npm run align",
    "verify:audio": "node scripts/verify-app-audio.mjs",
    "test": "node --test scripts/lib/*.test.mjs",
    "sample": "node scripts/make-samples.mjs",
    "auth": "node scripts/dropbox-auth.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
